generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String
  firstName     String      @default("")
  lastName      String      @default("")
  title         String      @default("")
  passwordHash  String
  role           UserRole     @default(MEMBER)
  institutionId  String?
  institution    Institution? @relation("UserPrimaryInstitution", fields: [institutionId], references: [id])
  cases              Case[]
  roleRequests       RoleRequest[]
  transfersSent      CaseTransfer[] @relation("TransfersSent")
  transfersReceived  CaseTransfer[] @relation("TransfersReceived")
  approvedAt         DateTime?
  acceptedTermsAt    DateTime?
  acceptedPrivacyAt  DateTime?
  termsVersion       String?
  lastLoginAt        DateTime?
  deletedAt          DateTime?
  createdAt     DateTime    @default(now())
}

enum UserRole {
  MEMBER
  HEAD_OF_DEPT
  ADMIN
  CLINICIAN     // legacy
  RESEARCHER    // legacy
}

model Institution {
  id      String  @id @default(cuid())
  name    String
  city    String
  country String  @default("Bulgaria")
  users   User[]  @relation("UserPrimaryInstitution")
}

// ─── Case ────────────────────────────────────────────────────────────────────

model Case {
  id            String      @id @default(cuid())
  caseCode      String?
  notes         String?
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        CaseStatus  @default(DRAFT)
  finalizedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  preop         PreoperativeAssessment?
  intraop       IntraoperativeRecord?
  postop        PostoperativeRecord?
  transfers     CaseTransfer[]
  lock          CaseLock?
  events        CaseEvent[]
  selections    CaseSelection[]
  fieldChanges  CaseFieldChange[]
  snapshot      CaseSnapshot?

  @@unique([userId, caseCode])
  @@index([status])
  @@index([userId, createdAt])
}

model CaseLock {
  caseId    String   @id
  userId    String
  deviceId  String
  expiresAt DateTime

  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model CaseTransfer {
  id          String         @id @default(cuid())
  caseId      String
  case        Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User           @relation("TransfersSent",     fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User           @relation("TransfersReceived", fields: [toUserId],   references: [id])
  initiatedBy String
  status      TransferStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?

  @@index([status])
  @@index([toUserId, status])
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum CaseStatus {
  DRAFT
  IN_PROGRESS
  AWAITING_REVIEW
  COMPLETE
}

// ─── Custom terms (free-text entries added by clinicians) ─────────────────────

model RoleRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  resolvedAt  DateTime?
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ICD-10 vocabulary (seeded from WHO ICD-10 + official BG MZ labels)
model Icd10Code {
  code     String         @id   // e.g. "I21"
  labelEn  String
  labelBg  String?
  synonyms Icd10Synonym[]
}

model Icd10Synonym {
  id        String    @id @default(cuid())
  icd10Code String
  icd10     Icd10Code @relation(fields: [icd10Code], references: [code], onDelete: Cascade)
  synonym   String
  @@index([icd10Code])
}

// LOINC codes for the 67-test canonical lab library (seeded once, not full LOINC import)
model LabLoinc {
  name          String  @id   // exact name from lab library
  loincCode     String
  unitCanon     String
  referenceLow  Float?
  referenceHigh Float?
}

// ATC drug classification tree (seeded from Athena CONCEPT.csv, vocab ATC)
model Atc {
  code       String  @id   // e.g. "N01AB"
  name       String
  level      Int           // 1-5
  parentCode String?
  @@index([parentCode])
  @@index([level])
}

// Drug registry (seeded from drugs.json, searchable by name/INN/ATC)
model Drug {
  id       String  @id @default(cuid())
  name     String
  inn      String?
  atcCode  String?
  form     String?
  strength String?
  @@index([name])
  @@index([inn])
  @@index([atcCode])
}

// Per-field preop/postop audit log (Theme D)
model CaseFieldChange {
  id       String   @id @default(cuid())
  caseId   String
  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  section  String   // "preop" | "postop"
  field    String
  oldValue String?
  newValue String?
  userId   String
  at       DateTime @default(now())
  @@index([caseId])
  @@index([caseId, section])
}

// Immutable snapshot written on finalization (Theme E)
model CaseSnapshot {
  id            String   @id @default(cuid())
  caseId        String   @unique
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  schemaVersion String   @default("2.0.0")
  snapshotJson  Json
  finalizedAt   DateTime @default(now())
}

model RevokedToken {
  jti       String   @id
  revokedAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// Immutable, event-sourced clinical events. Written in parallel with the legacy
// IntraoperativeRecord.keyEvents.log JSON (dual-write) — this table is the
// append-only audit trail and the future source of truth for the intraop chart.
model CaseEvent {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId         String?
  logicalId      String   @default("")          // stable client event id; versions share it
  version        Int      @default(1)
  status         String   @default("active")    // active | superseded | deleted
  type           String
  timestamp      DateTime
  label          String?
  value          String?
  unit           String?
  // Typed vital values (populated when type = "vital") so vitals are queryable as columns
  systolic       Int?
  diastolic      Int?
  heartRate      Int?
  spO2           Float?
  etco2          Float?
  temp           Float?
  // Coded drug fields (populated when type = "drug")
  atcCode        String?
  drugId         String?
  drugRoute      String?
  metadataJson   Json?
  source         String   @default("mobile")
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([caseId, timestamp])
  @@index([caseId, status])
  @@index([caseId, logicalId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entityId  String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model CustomTerm {
  id            String   @id @default(cuid())
  code          String   @unique  // "0000000", "0000001", …
  term          String
  termType      String   // "procedure" | "diagnosis" | "medication" | "allergy"
  institutionId String?  // null = legacy global; set = institution-scoped
  createdAt     DateTime @default(now())
}

// ─── Preoperative ────────────────────────────────────────────────────────────

model PreoperativeAssessment {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  ageYears   Int?
  sex        Sex
  heightCm   Float?
  weightKg   Float?
  bmi        Float?
  bloodType  BloodType?
  rhFactor   RhFactor?

  diagnosis              String
  diagnosesJson          Json?
  plannedProcedure       String
  proceduresJson         Json?
  icdCode                String?
  teamNotes              String?

  // Comorbidities as ICD-10 tagged list: [{label, sub, system}]
  comorbidities          Json     @default("[]")

  // Safety-critical fields kept explicit
  allergies              Boolean  @default(false)
  allergyDetails         String?
  latexAllergy           Boolean  @default(false)
  currentMedications     String?
  familyAnesthesiaProblems Boolean @default(false)
  familyAnesthesiaDetails  String?
  dentalProsthetics      Boolean  @default(false)
  looseTeeth             Boolean  @default(false)
  smoking                Boolean  @default(false)
  substanceAbuse         Boolean  @default(false)

  bpSystolic      Int?
  bpDiastolic     Int?
  heartRate        Int?
  heartArrhythmia  Boolean @default(false)
  spO2             Float?
  temperature     Float?
  respiratoryRate Int?

  mallampati             MallampatiClass?
  mouthOpeningCm         Float?
  thyromental            Float?
  neckMobility           NeckMobility?
  upperLipBiteTest       UpperLipBiteTest?
  retrognathia           Boolean @default(false)
  prominentIncisors      Boolean @default(false)
  facialHair             Boolean @default(false)
  difficultAirwayHistory Boolean @default(false)
  difficultAirwayNotes   String?
  cormackLehane          CormackLehane?

  asaScore         ASAScore?
  emergencySurgery Boolean @default(false)
  highRiskSurgery  Boolean @default(false)

  // Individual RCRI inputs — stored so the form can be restored accurately
  rcriIschemicHeart  Boolean @default(false)
  rcriCHF            Boolean @default(false)
  rcriCVD            Boolean @default(false)
  rcriInsulinDM      Boolean @default(false)
  rcriCreatinine     Boolean @default(false)

  // Computed risk scores
  rcriScore     Int?
  gutaScore     Float?
  apfelScore    Int?
  stopBangScore Int?

  // Individual Apfel inputs
  apfelPONVHistory   Boolean @default(false)
  apfelPostopOpioids Boolean @default(false)

  // Individual STOP-BANG inputs
  stopbangSnoring  Boolean @default(false)
  stopbangTired    Boolean @default(false)
  stopbangObserved Boolean @default(false)
  stopbangBP       Boolean @default(false)
  stopbangNeck     Boolean @default(false)

  labResults Json @default("[]")

  aiOptIn   Boolean @default(false)

  // Normalised mirrors of the JSON arrays above (queryable; written best-effort)
  diagnoses       PreopDiagnosis[]
  procedureRows   PreopProcedure[]
  comorbidityRows Comorbidity[]
  labRows         LabResult[]
  medications     Medication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Intraoperative ──────────────────────────────────────────────────────────

model IntraoperativeRecord {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  monthYear       String?
  durationMinutes Int?
  startTime DateTime
  endTime   DateTime?

  positions Json @default("[]")

  techniques     Json @default("[]")
  airwayDevice   AirwayDevice?
  tubeSize       Float?
  cuffed         Boolean?
  peepCmH2O      Float?
  ippv           Boolean @default(false)
  jetVentilation Boolean @default(false)
  fob            Boolean @default(false)
  airwayTools    Json    @default("[]")
  airwayNotes    String?
  cormackLehane  CormackLehane?
  airwayDevices    Json    @default("[]")
  ventilationModes Json    @default("[]")
  dltType          String?
  dltSide          String?
  dltSize          Float?
  endobronchialSize Float?

  volatileAgent     VolatileAgent?
  n2oPercent        Float?
  o2Percent         Float?
  n2oLitersPerMin   Float?
  o2LitersPerMin    Float?
  fgfLitersPerMin   Float?   // Fresh gas flow total (L/min)
  carrierGas        String?  // "air" | "n2o" | null (O2-only)
  fio2Percent       Float?   // FiO₂ %

  plexusBlock      PlexusBlock?
  cvkSite          CVKSite?
  arterialLineSite ArterialLineSite?

  ecg             Boolean @default(false)
  urinaryCatheter Boolean @default(false)
  stomachTube     Boolean @default(false)
  spO2Monitor     Boolean @default(true)
  invasiveBP      Boolean @default(false)
  cvpMonitor      Boolean @default(false)
  bglMonitor      Boolean @default(false)
  bloodGasMonitor Boolean @default(false)
  neuroMonitor    Boolean @default(false)
  nbpMonitor      Boolean @default(true)
  etco2Monitor    Boolean @default(false)
  tempMonitor     Boolean @default(false)
  paCatheter      Boolean @default(false)
  tee             Boolean @default(false)
  bis             Boolean @default(false)
  entropyMonitor  Boolean @default(false)
  nirsMonitor     Boolean @default(false)
  evokedPotentials Boolean @default(false)
  tofMonitor      Boolean @default(false)

  vascularAccesses Json @default("[]")

  premedicationEvening String?
  premedicationMorning String?

  drugsAdministered Json @default("[]")

  crystalloidsMl    Int?
  colloidsMl        Int?
  bloodMl           Int?
  bloodProductsNote String?
  urineMl           Int?

  timeSeriesData Json @default("[]")
  keyEvents      Json @default("[]")

  complications String?

  // Normalised mirror of vascularAccesses JSON (queryable; written best-effort)
  vascularAccessRows VascularAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Postoperative ───────────────────────────────────────────────────────────

model PostoperativeRecord {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  aldreteActivity       Int?
  aldreteRespiration    Int?
  aldreteCirculation    Int?
  aldreteConsciousness  Int?
  aldreteSpO2           Int?
  aldreteTotal          Int?

  recoveryBpSystolic  Int?
  recoveryBpDiastolic Int?
  recoveryHeartRate   Int?
  recoverySpO2        Float?
  painScoreNRS        Int?
  ponv                Boolean @default(false)
  temperatureCelsius  Float?

  complications    String?
  disposition      Disposition?
  dispositionNotes String?
  handoverItems    Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum BloodType {
  A
  B
  AB
  O
}

enum RhFactor {
  POSITIVE
  NEGATIVE
}

enum MallampatiClass {
  I
  II
  III
  IV
}

enum NeckMobility {
  FULL
  LIMITED
  FIXED
}

enum UpperLipBiteTest {
  CLASS_I
  CLASS_II
  CLASS_III
}

enum CormackLehane {
  I
  IIa
  IIb
  III
  IV
}

enum ASAScore {
  I
  II
  III
  IV
  V
  VI
}

enum PatientPosition {
  SUPINE
  PRONE
  LEFT_LATERAL
  RIGHT_LATERAL
  LITHOTOMY
  GYNECOLOGICAL
  TRENDELENBURG
  REVERSE_TRENDELENBURG
  FOWLER
  SITTING
  BEACH_CHAIR
  JACKKNIFE
  LLOYD_DAVIES
  KNEE_CHEST
  LATERAL_DECUBITUS
}

enum AnesthesiaTechnique {
  GENERAL_INHALATION
  GENERAL_TIVA
  GENERAL_COMBINED
  SPINAL
  EPIDURAL
  COMBINED_SPINAL_EPIDURAL
  PERIPHERAL_NERVE_BLOCK
  LOCAL
  SEDATION
}

enum AirwayDevice {
  FACE_MASK
  LMA
  ORAL_ETT
  NASAL_ETT
  SURGICAL_AIRWAY
}

enum VolatileAgent {
  SEVOFLURANE
  DESFLURANE
  ISOFLURANE
}

enum CVKSite {
  INTERNAL_JUGULAR
  EXTERNAL_JUGULAR
  SUBCLAVIAN
  FEMORAL
}

enum ArterialLineSite {
  RADIAL
  DORSALIS_PEDIS
  FEMORAL
  BRACHIAL
}

enum PlexusBlock {
  AXILLARY
  INTERSCALENE
  SUPRACLAVICULAR
  INFRACLAVICULAR
  FEMORAL
  SCIATIC
  POPLITEAL
  TAP
  ERECTOR_SPINAE
}

enum Disposition {
  WARD
  PACU
  ICU
}

// ─── Normalised clinical rows (v1.2) ─────────────────────────────────────────
// These mirror JSON arrays on the section records as queryable rows. They are
// written best-effort alongside the JSON (which stays authoritative), so a sync
// failure never blocks a clinical save. caseId is denormalised for research joins.

model PreopDiagnosis {
  id        String                 @id @default(cuid())
  preopId   String
  preop     PreoperativeAssessment @relation(fields: [preopId], references: [id], onDelete: Cascade)
  caseId    String
  code      String?
  label     String
  system    String?
  ordinal   Int                    @default(0)
  createdAt DateTime               @default(now())

  @@index([caseId])
  @@index([preopId])
  @@index([code])
}

model PreopProcedure {
  id          String                 @id @default(cuid())
  preopId     String
  preop       PreoperativeAssessment @relation(fields: [preopId], references: [id], onDelete: Cascade)
  caseId      String
  code        String?
  group       String?
  domain      String?
  description String?
  ordinal     Int                    @default(0)
  createdAt   DateTime               @default(now())

  @@index([caseId])
  @@index([preopId])
  @@index([code])
}

model Comorbidity {
  id        String                 @id @default(cuid())
  preopId   String
  preop     PreoperativeAssessment @relation(fields: [preopId], references: [id], onDelete: Cascade)
  caseId    String
  label     String
  code      String?
  icd10Code String?   // ICD-10 code (Gap 2: comorbidities coded same as diagnoses)
  system    String?
  ordinal   Int                    @default(0)
  createdAt DateTime               @default(now())

  @@index([caseId])
  @@index([preopId])
  @@index([code])
  @@index([icd10Code])
}

model LabResult {
  id            String                 @id @default(cuid())
  preopId       String
  preop         PreoperativeAssessment @relation(fields: [preopId], references: [id], onDelete: Cascade)
  caseId        String
  test          String
  value         String?
  valueNum      Float?    // parsed numeric value in canonical unit
  unit          String?
  unitCanon     String?   // canonical unit from LabLoinc
  loincCode     String?   // LOINC code for this test
  referenceLow  Float?
  referenceHigh Float?
  abnormalFlag  String?   // "low" | "normal" | "high" | "critical"
  takenAt       DateTime?
  source        String?   // "manual" | "ai-scan" | "import"
  ordinal       Int                    @default(0)
  createdAt     DateTime               @default(now())

  @@index([caseId])
  @@index([preopId])
  @@index([test])
  @@index([loincCode])
}

// Preop medications as coded rows (Theme C3; currentMedications JSON kept for backwards compat)
model Medication {
  id        String                 @id @default(cuid())
  preopId   String
  preop     PreoperativeAssessment @relation(fields: [preopId], references: [id], onDelete: Cascade)
  caseId    String
  drugId    String?   // FK to Drug if matched
  nameRaw   String    // raw label as entered
  inn       String?
  atcCode   String?
  dose      String?
  route     String?
  frequency String?
  ordinal   Int                    @default(0)
  createdAt DateTime               @default(now())

  @@index([caseId])
  @@index([preopId])
  @@index([atcCode])
}

model VascularAccess {
  id        String               @id @default(cuid())
  intraopId String
  intraop   IntraoperativeRecord @relation(fields: [intraopId], references: [id], onDelete: Cascade)
  caseId    String
  site      String?
  siteLabel String?
  size      String?
  sizeUnit  String?
  ordinal   Int                  @default(0)
  createdAt DateTime             @default(now())

  @@index([caseId])
  @@index([intraopId])
}

// Generic store for controlled-vocabulary multi-selects (positions, techniques,
// airway devices/tools, ventilation modes, handover items).
model CaseSelection {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  section   String   // "intraop" | "postop"
  category  String   // "position" | "technique" | "airwayTool" | "airwayDevice" | "ventilationMode" | "handoverItem"
  value     String
  ordinal   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([category, value])
}
