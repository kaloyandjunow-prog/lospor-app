{
  "name": "lospor-app",
  "version": "10.3.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "i18n:inventory": "node scripts/inventory-untranslated-ui.mjs",
    "legal:manifest": "node scripts/generate-cloud-legal-manifest.mjs",
    "check:crossapp-ci": "node --test scripts/crossapp-ci-contract.test.mjs",
    "check:shared-core": "node scripts/check-shared-core-boundaries.mjs",
    "verify:boundaries": "node scripts/check-shared-core-boundaries.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "smoke": "playwright test --config playwright.smoke.config.ts",
    "e2e:db:up": "node scripts/e2e-db.mjs up",
    "e2e:db:reset": "node scripts/e2e-db.mjs reset",
    "e2e:db:down": "node scripts/e2e-db.mjs down",
    "e2e:seed": "node scripts/e2e-db.mjs seed",
    "e2e:crossapp": "npm --prefix ../lospor-mobile run export:web:e2e && playwright test --config playwright.crossapp.config.ts"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "serialize-javascript": "^7.0.6",
    "minimatch": "11.0.5",
    "nanoid": "^3.3.18",
    "fast-uri": "^3.1.7",
    "qs": "^6.15.4",
    "js-yaml": "4.3.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dragdroptouch/drag-drop-touch": "2.0.3",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.9.2",
    "@lospor/core": "github:kaloyandjunow-prog/lospor-core#v10.3.0",
    "@sentry/nextjs": "^11.11.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "driver.js": "^1.11.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "@sentry/cli@2.58.6": true,
    "@swc/core@1.15.47": true
  }
}
